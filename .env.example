# Local demo values only. setup:env generates private JWT/database passwords.
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api
DATABASE_URL=postgresql://assignment:replace-with-local-password@127.0.0.1:5433/inventory_development
TEST_DATABASE_URL=postgresql://assignment:replace-with-local-password@127.0.0.1:5433/inventory_test
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEBHOOK_SECRET=local-demo-webhook-secret
# Optional: directory containing initdb, pg_ctl, psql, and createdb.
# PG_BIN_PATH=C:/Program Files/PostgreSQL/16/bin
